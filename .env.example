# Copy this file to .env and fill in your keys. Never commit .env.

# Always required: Google is used for embeddings (and for the LLM when LLM_PROVIDER=google)
GOOGLE_API_KEY=your-google-api-key

# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key

# Which LLM block in config/config.yaml to use: groq | google
LLM_PROVIDER=groq

# Optional overrides
# CONFIG_PATH=config/config.yaml
# DATA_STORAGE_PATH=data
# LOG_DIR=logs

# API authentication (leave unset for local development = no auth, everyone is admin)
# Format: key:role|role,key:role   e.g.
# API_KEYS=change-me-eng:engineering,change-me-crew:cabin_crew|flight_ops,change-me-admin:admin
